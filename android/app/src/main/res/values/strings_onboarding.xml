    <string name="onboarding_feature_cast_desc">Play to Chromecast speakers and TVs with per-device quality settings.</string>
    <string name="onboarding_feature_quality">Quality that adapts</string>
    <string name="onboarding_feature_quality_desc">Different transcoding on Wi-Fi, mobile data, or when the network slows down.</string>
