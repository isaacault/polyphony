    <string name="onboarding_tagline">One player. Every voice.</string>
    <string name="onboarding_pitch">Stream your own music collection from Navidrome, Subsonic or Jellyfin — with casting, offline-ready browsing and smart quality rules.</string>
    <string name="onboarding_feature_servers">Your servers, one library</string>
    <string name="onboarding_feature_servers_desc">Subsonic, OpenSubsonic, Navidrome and Jellyfin, side by side.</string>
