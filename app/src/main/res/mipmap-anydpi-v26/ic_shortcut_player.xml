<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon for the "player" launcher shortcut: reuses the launcher background so the
     shortcut badge matches the app icon. minSdk is 26, so no pre-v26 raster fallback is needed. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_shortcut_player" />
</adaptive-icon>
