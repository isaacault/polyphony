{
  "about": "The URL a DLNA or Cast speaker is given for one the app built from a server's base URL. A receiver address (override) replaces the base URL outright (no scheme: http); otherwise, for plain http only, a private LAN IP the app resolved for the host replaces it (lanIp). Android: android/playback rewriteForReceiver; Swift: PolyphonyKit ReceiverURL.rewrite.",
  "cases": [
    {"name": "a receiver address replaces the base URL, keeping path and query",
     "url": "https://music.example.com/rest/stream?u=me&t=abc&id=42", "baseUrl": "https://music.example.com", "override": "http://192.168.1.10:4533/",
     "expected": "http://192.168.1.10:4533/rest/stream?u=me&t=abc&id=42"},
    {"name": "a receiver address without a scheme is http",
     "url": "https://music.example.com/rest/stream?u=me&t=abc&id=42", "baseUrl": "https://music.example.com", "override": "192.168.1.10:4533",
     "expected": "http://192.168.1.10:4533/rest/stream?u=me&t=abc&id=42"},
    {"name": "continuo's LAN door, as continuo hands it out",
     "url": "https://continuo.ault.me/rest/stream?id=40O5&u=isaac&t=x&s=y", "baseUrl": "https://continuo.ault.me", "override": "http://192.168.0.101",
     "expected": "http://192.168.0.101/rest/stream?id=40O5&u=isaac&t=x&s=y"},
    {"name": "a server under a path: the path goes with the base URL",
     "url": "https://home.example.com/navidrome/rest/getCoverArt?id=al-1", "baseUrl": "https://home.example.com/navidrome/", "override": "http://10.0.0.5:4533",
     "expected": "http://10.0.0.5:4533/rest/getCoverArt?id=al-1"},
    {"name": "a receiver address under a path keeps it",
     "url": "https://music.example.com/rest/stream?id=1", "baseUrl": "https://music.example.com", "override": "http://10.0.0.5/music/",
     "expected": "http://10.0.0.5/music/rest/stream?id=1"},
    {"name": "the receiver address leaves other origins alone",
     "url": "https://cdn.example.net/art.jpg", "baseUrl": "https://music.example.com", "override": "http://192.168.1.10:4533",
     "expected": "https://cdn.example.net/art.jpg"},
    {"name": "a blank receiver address is none",
     "url": "https://music.example.com/x", "baseUrl": "https://music.example.com", "override": "  ",
     "expected": "https://music.example.com/x"},
    {"name": "a LAN IP replaces a plain http host",
     "url": "http://music.example.com:4533/rest/stream?id=42", "baseUrl": "http://music.example.com:4533", "lanIp": "192.168.1.10",
     "expected": "http://192.168.1.10:4533/rest/stream?id=42"},
    {"name": "never under https (the certificate wouldn't match)",
     "url": "https://music.example.com/rest/stream?u=me&t=abc&id=42", "baseUrl": "https://music.example.com", "lanIp": "192.168.1.10",
     "expected": "https://music.example.com/rest/stream?u=me&t=abc&id=42"},
    {"name": "an IP host is left alone",
     "url": "http://10.0.0.5:4533/rest/stream?id=1", "baseUrl": "http://10.0.0.5:4533", "lanIp": "192.168.1.10",
     "expected": "http://10.0.0.5:4533/rest/stream?id=1"},
    {"name": "no LAN IP, nothing to do",
     "url": "http://music.example.com/x", "baseUrl": "http://music.example.com",
     "expected": "http://music.example.com/x"}
  ]
}
